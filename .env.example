# ─── Section E — environment variables ───────────────────────────────────────
# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. Never commit real values.

# Postgres connection string (Neon, Supabase, Vercel Postgres, Railway…).
# Leave empty locally to use the embedded database in .data/pglite.
DATABASE_URL=

# Random string, 32+ characters. Signs the login cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Admin password. Prefer the hash (npm run hash-password -- "your password").
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=

# Default timetable source — the share link of the official workbook.
# Can also be set (and changed any time) from /admin/timetable without a redeploy.
TIMETABLE_URL=
TIMETABLE_SECTION=E
# How often (seconds) the source is re-downloaded at most. Default 120.
TIMETABLE_TTL_SECONDS=120

# Optional: Google API key with the Drive API enabled. Gives exact "last edited"
# times for Google Drive files. Without it, changes are detected by content.
GOOGLE_API_KEY=

# College time zone for "today" / "next class" (used on server and in the browser).
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata

# Homework reminders (Web Push). Generate with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Protects the daily reminder job (Vercel Cron sends it automatically as a Bearer token).
CRON_SECRET=

# Public URL of the site (used in the Apps Script relay and WhatsApp messages).
# Optional — detected from the request when empty.
NEXT_PUBLIC_SITE_URL=
